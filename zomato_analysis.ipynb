import pandas as pd
import numpy as np
df = pd.read_csv("Zomato Dataset.csv")
print("Dataset Preview:")
print(df.head())
time_taken = df["Time_taken (min)"].to_numpy()
delivery_person_age = df["Delivery_person_Age"].to_numpy()
delivery_person_ratings = df["Delivery_person_Ratings"].to_numpy()
def mean(arr):
    return np.mean(arr)

def median(arr):
    return np.median(arr)

def variance(arr):
    return np.var(arr)

def correlation(x, y):
    return np.corrcoef(x, y)[0, 1]
print("\n Statistics on Delivery Time:")
print("Mean:", mean(time_taken))
print("Median:", median(time_taken))
print("Variance:", variance(time_taken))

print("\n Correlations with Delivery Time:")
print("Age vs Time:", correlation(delivery_person_age, time_taken))
print("Ratings vs Time:", correlation(delivery_person_ratings, time_taken))
